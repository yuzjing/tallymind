{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/transaction": {
            "post": {
                "description": "接收标准 JSON 账单数据，校验后追加写入本地 Beancount 纯文本账本",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "账单管理"
                ],
                "summary": "通用记账 API 接口",
                "parameters": [
                    {
                        "type": "string",
                        "description": "记账人 ID (如 husband)",
                        "name": "X-User-ID",
                        "in": "header"
                    },
                    {
                        "type": "string",
                        "description": "渠道来源 (如 wecom_api_plugin)",
                        "name": "X-Source-Channel",
                        "in": "header"
                    },
                    {
                        "description": "账单请求体",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ledger.BatchTransactions"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "成功返回",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    },
                    "400": {
                        "description": "参数校验或保存失败",
                        "schema": {
                            "$ref": "#/definitions/handler.APIResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.APIResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "ledger.BatchTransactions": {
            "type": "object",
            "required": [
                "transactions"
            ],
            "properties": {
                "transactions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ledger.Transaction"
                    }
                }
            }
        },
        "ledger.Metadata": {
            "type": "object",
            "properties": {
                "beneficiary": {
                    "description": "受益人 (如 family/baby)",
                    "type": "string"
                },
                "discount_amount": {
                    "description": "优惠金额",
                    "type": "string"
                },
                "extra": {
                    "description": "动态扩展字典，支持任意自定义元数据",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "invoice_status": {
                    "description": "发票状态 (pending/done)",
                    "type": "string"
                },
                "link": {
                    "description": "关联单号 (写为 ^order-12345)",
                    "type": "string"
                },
                "location": {
                    "description": "地点",
                    "type": "string"
                },
                "original_amount": {
                    "description": "优惠前原价",
                    "type": "string"
                },
                "reporter": {
                    "description": "记账人/操作人 (如 husband)",
                    "type": "string"
                },
                "source_channel": {
                    "description": "渠道 (text/voice/image)",
                    "type": "string"
                },
                "time": {
                    "description": "交易时间 (如 18:20:05)",
                    "type": "string"
                }
            }
        },
        "ledger.Transaction": {
            "type": "object",
            "required": [
                "amount"
            ],
            "properties": {
                "account": {
                    "description": "支付/资产账户",
                    "type": "string"
                },
                "amount": {
                    "description": "金额必填且必须 \u003e 0",
                    "type": "number"
                },
                "category": {
                    "description": "支出/收入科目",
                    "type": "string"
                },
                "currency": {
                    "description": "货币 (默认 CNY)",
                    "type": "string"
                },
                "date": {
                    "description": "交易日期 YYYY-MM-DD",
                    "type": "string"
                },
                "metadata": {
                    "description": "扩展元数据",
                    "allOf": [
                        {
                            "$ref": "#/definitions/ledger.Metadata"
                        }
                    ]
                },
                "narration": {
                    "description": "详细备注 (上限 1000 字符，可为空)",
                    "type": "string",
                    "maxLength": 1000
                },
                "payee": {
                    "description": "商户名 (上限 500 字符)",
                    "type": "string",
                    "maxLength": 500
                },
                "tags": {
                    "description": "标签 (如 [\"#公司报销\"])",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "type": {
                    "description": "交易类型: expense / income / refund",
                    "type": "string"
                }
            }
        }
    }
}