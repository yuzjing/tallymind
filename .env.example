# 1. 应用与特性开关
APP_ENV=development
DEBUG=false
LOG_LEVEL=info
SERVER_PORT=8080

# 2. 通道控制开关 
ENABLE_WECOM_WSS=true
ENABLE_HTTP_API=true

# 3. 核心功能与 Git 自动备份开关
ENABLE_LLM=true
ENABLE_GIT_BACKUP=false
GIT_BACKUP_CRON=0 */6 * * *

# 4. 定时报表开关与周期
ENABLE_REPORTER=true
WEEKLY_REPORT_CRON=0 20 * * 0
MONTHLY_REPORT_CRON=0 9 1 * *

# 5. Beancount 账本降级配置
BEANCOUNT_FILE_PATH=main.bean
DEFAULT_CURRENCY=CNY
DEFAULT_REPORTER=husband
FALLBACK_CATEGORY=Expenses:Uncategorized
FALLBACK_ACCOUNT=Assets:Pending:Unknown
FALLBACK_PAYEE=日常消费

# 6. 大模型 LLM 配置
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# 7. 企业微信长连接配置
WECOM_BOT_ID=your_bot_id
WECOM_BOT_SECRET=your_bot_secret