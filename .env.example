# 1. 应用与特性开关
APP_ENV=development
DEBUG=false
LOG_LEVEL=info
LOG_DIR=
SERVER_PORT=8080

# 2. 通道控制开关 
ENABLE_WECOM_WSS=true
ENABLE_HTTP_API=true
ENABLE_WECOM_HTTP=true
WECOM_CORP_ID=ww1234567890abcdef
WECOM_AGENT_ID=1000002
WECOM_SECRET=your_app_secret_here
WECOM_TOKEN=your_callback_token_here
WECOM_ENCODING_AES_KEY=your_encoding_aes_key_43_chars_long

# 3. 核心功能与 Git 自动备份开关
ENABLE_LLM=true
ENABLE_GIT_BACKUP=false
GIT_BACKUP_CRON=0 */6 * * *

# 4. 定时报表开关与周期
ENABLE_REPORTER=true
REPORTER_CHANNELS=channel1,channel2,channel3
ALERT_CHANNELS=channel1,channel2,channel3


TEMPLATE_DIR=templates
PUBLIC_URL=https://localhost:8080

# 5. Beancount 账本降级配置
BEANCOUNT_FILE_PATH=main.bean
DEFAULT_CURRENCY=CNY
DEFAULT_REPORTER=husband
FALLBACK_CATEGORY=Expenses:Uncategorized
FALLBACK_ACCOUNT=Assets:Pending:Unknown
FALLBACK_PAYEE=日常消费

# 6. 大模型 LLM 配置
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# 7. 企业微信配置
WECOM_BOT_ID=your_bot_id
WECOM_BOT_SECRET=your_bot_secret
WECOM_SUCCESS_TEMPLATE=wecom/example_success_text.yaml
WECOM_FAILURE_TEMPLATE=wecom/example_failure_text.yaml